# ── Google Cloud ──────────────────────────────────────────────────────────────
GCP_PROJECT=your-gcp-project-id
REGION=asia-south1

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-maps-api-key
VERTEX_LOCATION=us-central1          # Gemini 1.5 Flash region

# ── Firestore ─────────────────────────────────────────────────────────────────
FIRESTORE_COLLECTION_ZONES=zones

# ── Pub/Sub ───────────────────────────────────────────────────────────────────
CROWD_PUBSUB_TOPIC=venue-crowd-events
PUBSUB_SUBSCRIPTION=venue-crowd-events-sub
EMERGENCY_PUBSUB_TOPIC=venue-emergency

# ── Security ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-service-xxxx.run.app
RATE_LIMIT_PER_MIN=60

# ── GitHub Actions secrets (set in GitHub → Settings → Secrets) ───────────────
# GCP_PROJECT_ID       = your GCP project ID
# WIF_PROVIDER         = projects/NUMBER/locations/global/workloadIdentityPools/...
# WIF_SERVICE_ACCOUNT  = github-actions@PROJECT.iam.gserviceaccount.com
